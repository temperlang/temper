# Syntax for declared failures (RFC 164) after the grammar step:
# `throw x` and `try x` are calls like `return x`; `catch` is a call of
# the handled expression, the binding if any (declared), and the block,
# as `if` takes its blocks; `error case` is `#errorCase` with the name
# as `class` has it. Kotlin Temper has none of it, so compat/check_ast.py
# differs here.

=== throw and try
throw e;
let x = try f(a);
--- ast
(Block (Call throw e) (Decl ^x \init (Call try (Call f a))) #void)

=== catch with and without a binding
f() catch (e) { g(e) };
f() catch { 0 };
--- ast
(Block
  (Call catch (Call f) ^e (Fun (Block (Call g e))))
  (Call catch (Call f) (Fun (Block 0)))
  #void)

=== do catch
do { try a() } catch (e) { b(e) }
--- ast
(Call
  catch
  (Call do (Fun (Block (Call try (Call a)))))
  ^e
  (Fun (Block (Call b e))))

=== jumps in a handler
f() catch { return 0 };
--- ast
(Block (Call catch (Call f) (Fun (Block (Call return 0)))) #void)

=== catch after orelse's operand
let n = f() orelse g() catch { 1 };
--- ast
(Block
  (Decl
    ^n
    \init
    (Call
      #desugarOperation
      orelse
      (Call f)
      (Call catch (Call g) (Fun (Block 1)))))
  #void)

=== error case
error case NotFound;
export error case Bad(public text: String, public word: Int);
--- ast
(Block
  (Call #errorCase \word ^NotFound)
  (Call
    @
    export
    (Call
      #errorCase
      \word
      ^Bad
      (Call @ public (Block \_complexArg_ text \type String))
      (Call @ public (Block \_complexArg_ word \type Int))))
  #void)

=== error stays a name
let error = 1;
error.message;
--- ast
(Block (Decl ^error \init 1) (Call %. error \message) #void)

=== a catch handler must be a block
f() catch 0;
f() catch (e) { a } + 1;
f() catch (e, g) { a };
f() catch (1) { a };
--- ast
(Block (Error) (Error) (Error) (Error) #void)
error 0..11: Expected a block after `catch`, or a name in parentheses and a block, as in `catch (e) { … }`
error 13..36: A `catch` block ends its expression; put the `catch` in parentheses to use its value
error 38..60: Expected a block after `catch`, or a name in parentheses and a block, as in `catch (e) { … }`
error 62..81: Expected a block after `catch`, or a name in parentheses and a block, as in `catch (e) { … }`

=== catch with nothing before it is a call, as orelse is, for the frontend to reject
catch (e) { a };
(+) catch { a };
--- ast
(Block
  (Call catch e (Fun (Block a)))
  (Call catch (Error) (Fun (Block a)))
  #void)
error 18..19: Expected a Expression here
