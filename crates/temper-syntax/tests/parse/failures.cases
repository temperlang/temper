# Syntax for declared failures (RFC 164): `throw`, `try`, `catch`,
# `do { … } catch`, and `error case`. Kotlin Temper has none of it, so
# compat/check_parse.py differs here. Format and updating: see
# tests/parse.rs.

=== throw as a prefix operator
throw e;
let x = y ?? throw e;
--- tree
(Semi (Throw throw e) ; (Eq [let x] = (Coalesce y ?? (Throw throw e))) ;)

=== try covers the whole expression to its right
let c = try lookup(s).column();
try a() + b();
--- tree
(Semi
  (Eq
    [let c]
    =
    (Try try (Paren (Dot (Paren lookup "(" s ")") . column) "(" ")")))
  ;
  (Try try (Plus (Paren a "(" ")") + (Paren b "(" ")")))
  ;)

=== try ends at a comma, so arguments each take one
f(try a(), try b());
--- tree
(Semi
  (Paren
    f
    "("
    (Comma (Try try (Paren a "(" ")")) , (Try try (Paren b "(" ")")))
    ")")
  ;)

=== try inside orelse, and orelse after try
let x = f() orelse try g();
let y = try f() orelse g();
--- tree
(Semi
  (Eq [let x] = (OrElse (Paren f "(" ")") orelse (Try try (Paren g "(" ")"))))
  ;
  (Eq [let y] = (OrElse (Try try (Paren f "(" ")")) orelse (Paren g "(" ")")))
  ;)

=== try await
let v = try await p;
--- tree
(Semi (Eq [let v] = (Try try (Await await p))) ;)

=== try before a joined call
try if (c) { a() } else { b() };
--- tree
(Semi
  (Try
    try
    (CallJoin
      (Curly (Paren if "(" c ")") { (Paren a "(" ")") })
      callJoin:
      (Curly else { (Paren b "(" ")") })))
  ;)

=== catch with a binding
let n = f() catch (e) { g(e) };
--- tree
(Semi
  (Eq
    [let n]
    =
    (Catch
      (Paren f "(" ")")
      catch
      (Curly (ParenGroup "(" e ")") { (Paren g "(" e ")") })))
  ;)

=== catch without a binding
let n = f() catch { 0 };
--- tree
(Semi (Eq [let n] = (Catch (Paren f "(" ")") catch (CurlyGroup { 0 }))) ;)

=== do catch is catch after a do block
do { try a(); try b() } catch (e) { c(e) }
--- tree
(Catch
  (Curly
    do
    {
    (Semi (Try try (Paren a "(" ")")) ; (Try try (Paren b "(" ")")))
    })
  catch
  (Curly (ParenGroup "(" e ")") { (Paren c "(" e ")") }))

=== catch on the line after a block continues it, as orelse does
do {
  a()
}
catch (e) {
  b()
}
x
--- tree
(Semi
  (Catch
    (Curly do { (Paren a "(" ")") })
    catch
    (Curly (ParenGroup "(" e ")") { (Paren b "(" ")") }))
  ;
  x)

=== catch binds tighter than orelse, and chains to the left
let a = f() catch (e) { g() } orelse 0;
let b = f() orelse g() catch { 1 };
let c = f() catch { 1 } catch { 2 };
--- tree
(Semi
  (Eq
    [let a]
    =
    (OrElse
      (Catch
        (Paren f "(" ")")
        catch
        (Curly (ParenGroup "(" e ")") { (Paren g "(" ")") }))
      orelse
      0))
  ;
  (Eq
    [let b]
    =
    (OrElse
      (Paren f "(" ")")
      orelse
      (Catch (Paren g "(" ")") catch (CurlyGroup { 1 }))))
  ;
  (Eq
    [let c]
    =
    (Catch
      (Catch (Paren f "(" ")") catch (CurlyGroup { 1 }))
      catch
      (CurlyGroup { 2 })))
  ;)

=== try then catch
let n = try f() catch (e) { 0 };
--- tree
(Semi
  (Eq
    [let n]
    =
    (Catch
      (Try try (Paren f "(" ")"))
      catch
      (Curly (ParenGroup "(" e ")") { 0 })))
  ;)

=== nested do catch
do {
  do { try a() } catch { try b() }
} catch (e) { c }
--- tree
(Catch
  (Curly
    do
    {
    (Catch
      (Curly do { (Try try (Paren a "(" ")")) })
      catch
      (CurlyGroup { (Try try (Paren b "(" ")")) }))
    })
  catch
  (Curly (ParenGroup "(" e ")") { c }))

=== jumps in handlers
for (let x of xs) {
  let a = f(x) catch { continue };
  let b = g(x) catch (e) { break };
  h(x) catch { return 0 };
}
--- tree
(Curly
  (Paren for "(" (Of [let x] of xs) ")")
  {
  (Semi
    (Eq [let a] = (Catch (Paren f "(" x ")") catch (CurlyGroup { continue })))
    ;
    (Eq
      [let b]
      =
      (Catch (Paren g "(" x ")") catch (Curly (ParenGroup "(" e ")") { break })))
    ;
    (Catch (Paren h "(" x ")") catch (CurlyGroup { (Return return 0) }))
    ;)
  })

=== error case declarations are words, which the grammar step reads
error case NotFound;
export error case Bad(public text: String);
--- tree
(Semi
  [error case NotFound]
  ;
  (At
    @
    export
    (Paren [error case Bad] "(" (At @ public (HighColon text : String)) ")"))
  ;)

=== member names after a dot may be the new words
x.try; x.catch; x.throw;
--- tree
(Semi (Dot x . try) ; (Dot x . catch) ; (Dot x . throw) ;)

=== error recovery: missing operands and blocks
try;
f() catch;
f() catch (e);
--- tree
(Semi
  (Try try)
  ;
  (Catch (Paren f "(" ")") catch)
  ;
  (Catch (Paren f "(" ")") catch (ParenGroup "(" e ")"))
  ;)
error 0..3: Operator Try expects at least 1 operands but got 0
error 5..14: Operator Catch expects at least 2 operands but got 1
