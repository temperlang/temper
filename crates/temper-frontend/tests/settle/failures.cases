caused by a bubble

=== a panic passes catch
class NotFound(public key: String) extends Error {}
let risky(n: Int): Int throws NotFound {
  if (n > 1) { panic() }
  if (n > 0) { throw new NotFound("n"); }
  n
}
console.log("${risky(1) catch { -1 }}");
let r = risky(2) catch { -1 };
console.log("after ${r}");
--- settled
(Block
  (Class ^NotFound:0 Error (Param ^key:4 String))
  (Let
    ^risky:1
    (Fn
      (Let ^n:5 Int)
      (Call throws Int NotFound:0)
      (Block
        (If (Call > n:5 1) (Block (Call panic)) (Block))
        (If
          (Call > n:5 0)
          (Block (Fail (Call new NotFound:0 "n")) #void)
          (Block))
        n:5)))
  (Call
    (Call . console \log)
    (Call cat (Orelse (Call risky:1 1) (Block (Call - 1)))))
  (Let ^r:2 (Orelse (Call risky:1 2) (Block (Call - 1))))
  (Call (Call . console \log) (Call cat "after " r:2))
  #void)
log -1
Panicked: panic()

