=== failure parameters solve to declared failures
class NotFound(public key: String) extends Error {}
let lookup(key: String): Int throws NotFound { throw new NotFound(key) }
let apply<E extends Error>(f: fn (): Int throws E): Int throws E { f() }
let a(): Int throws NotFound { apply(fn (): Int throws NotFound { lookup("a") }) }
let b(): Int throws NotFound { apply { lookup("b") } }
let c(): Int { apply { 1 } }
let d(): Int { apply { lookup("d") } }
let run(f: fn (): Int): Int { f() }
let e(): Int { run { lookup("e") } }
let runs(f: fn (): Int throws NotFound): Int throws NotFound { f() }
let g(): Int throws NotFound { runs { lookup("g") } }
let h(): Int throws NotFound { runs { 1 } }
let i(): Int throws NotFound { runs { bubble() } }
