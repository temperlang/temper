=== an uncaught failure says its message, where it was thrown, and its causes
class NotFound(public key: String) extends Error {}
class LookupFailed(public name: String) extends Error {}
let lookup(key: String): Int throws NotFound { throw new NotFound(key) }
let setting(name: String): Int throws LookupFailed {
  lookup(name) catch { throw new LookupFailed(name) }
}
console.log("before");
setting("port");
console.log("after");
--- settled
(Block
  (Class ^NotFound:0 Error (Param ^key:5 String))
  (Class ^LookupFailed:1 Error (Param ^name:7 String))
  (Let
    ^lookup:2
    (Fn
      (Let ^key:8 String)
      (Call throws Int NotFound:0)
      (Block (Fail (Call new NotFound:0 key:8)))))
  (Let
    ^setting:3
    (Fn
      (Let ^name:9 String)
      (Call throws Int LookupFailed:1)
      (Block
        (Orelse
          (Call lookup:2 name:9)
          (Block (Fail (Call new LookupFailed:1 name:9)))))))
  (Call (Call . console \log) "before")
  (Call setting:3 "port")
  (Call (Call . console \log) "after")
  #void)
