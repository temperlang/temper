=== failures are values
class NotFound(public key: String) extends Error {}
let lookup(key: String): Int throws NotFound { throw new NotFound(key) }
var kept = new NotFound("none");
let v = lookup("k") catch (e) { kept = e; -1 };
let problems = [new NotFound("x"), kept];
let again(p: NotFound): Int throws NotFound { throw p }
console.log(problems.join(",") { p => p.key });
