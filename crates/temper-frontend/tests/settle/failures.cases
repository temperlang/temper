=== Bubble and declared failures don't mix
class NotFound(public key: String) extends Error {}
let lookup(key: String): Int throws NotFound { throw new NotFound(key) }
let a(): Int throws Bubble { lookup("a") }
let b(): Int throws NotFound { bubble() }
let c(s: String): Int throws NotFound { s.toInt32() }
let d(): Int throws Bubble { lookup("d") catch { bubble() } }
let e(s: String): Int throws NotFound { s.toInt32() catch { throw new NotFound(s) } }
let f(s: String): Int { s.toInt32() catch (x) { 0 } }
let g(s: String): Int { s.toInt32() catch { 0 } }
