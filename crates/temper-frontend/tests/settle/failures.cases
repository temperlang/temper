=== Bubble and declared failures don't mix
sealed interface AppError extends Error {}
class NotFound(public key: String) extends AppError {}
let lookup(key: String): Int throws NotFound { throw new NotFound(key) }
let a(): Int throws Bubble { lookup("a") }
let b(): Int throws NotFound { bubble() }
let c(s: String): Int throws NotFound { s.toInt32() orelse bubble() }
let d(): Int throws Bubble { lookup("d") catch { bubble() } }
let e(s: String): Int throws NotFound { (s.toInt32() orelse bubble()) catch { throw new NotFound(s) } }
let f(s: String): Int { (s.toInt32() orelse bubble()) catch (x) { 0 } }
let g(s: String): Int { (s.toInt32() orelse bubble()) catch { 0 } }
