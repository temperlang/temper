# Declared failures (RFC 164; notes/typing.md, "Declared failures"):
# failure types extending core's root, `Error`; `throws E`; `throw`;
# `try`, optional for now; `catch`, its binding typed as what its operand
# may fail with; and `Bubble`, which never mixes with declared failures
# implicitly. Each rule has a legal case beside its error. The
# interpreter doesn't run `throw` or a `catch` binding yet.
=== a failure class, thrown, propagated, and handled
class NotFound(public key: String) extends Error {}
let lookup(key: String): Int throws NotFound {
  if (key == "a") { return 1; }
  throw new NotFound(key);
}
let sum(a: String, b: String): Int throws NotFound {
  let x = try lookup(a);
  let y = lookup(b);
  x + y
}
let found = lookup("a") orelse -1;
let m = lookup("b") catch { -1 };
let n = lookup("q") catch (e) { console.log(e.key); 0 };
let total = sum("a", "a") catch (e) { console.log(e.key); 0 };
console.log("${found} ${total}");
let k: Int = lookup("q") catch (e) { e };
--- settled
