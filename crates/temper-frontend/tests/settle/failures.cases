=== failure types: non-generic, sealed interfaces, one root each
// A root is a sealed interface that extends Error itself; a library may
// have several, and members. Every failure type is under one.
sealed interface A1 extends Error {}
sealed interface A2 extends Error {}
sealed interface Positioned extends Error { public get position(): Int; }
interface Plain {}
class Box<T>(public t: T) extends A1 {}
interface Loose extends Error {}
interface Looser extends A1 {}
sealed interface Fine extends A1 {}
class Both extends A1, A2 {}
class One extends A1, Plain {}
class Deep extends Fine, A2 {}
class Direct extends Error {}
sealed interface Under extends Error, A1 {}
class At(public position: Int) extends Positioned {}
let at(): Int throws Positioned { throw new At(4) }
console.log((at() catch (e) { e.position }).toString());
--- settled
