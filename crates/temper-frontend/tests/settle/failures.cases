            (Call is e:15 EmptyText:1)
            0
            (If (Call is e:15 BadSign:2) 9 (Block)))))))
  (Let
    ^narrow:7
    (Fn
      (Let ^text:16 String)
      (Call throws Int BadSign:2)
      (Block (Call parseSign:4 text:16)))))
