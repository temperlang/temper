=== a failure parameter is bound by Error where it follows throws
// RFC 164: a type parameter used after `throws` in its declaration, as
// `E` in `fn (): Int throws E`, is a failure parameter, bound by
// `Error` without saying so, so generic code may throw it, read its
// message, and check it against failure types. A `@fun` interface's
// and a class's alike. What isn't a failure can't bind it (s1). A type
// parameter not after `throws` is bound by `AnyValue` as before (v1).
sealed interface AppError extends Error {}
class Missing(public key: String) extends AppError {}
let find(key: String): Int throws Missing { throw new Missing(key) }
let again<E>(f: fn (): Int throws E): Int throws E {
  f() catch (e) { console.log("again ${e.message}"); throw e }
}
let named<E>(f: fn (): Int throws E): String {
  f().toString() catch (e) { when (e) { is Missing -> "missing"; else -> e.message } }
}
@fun interface Thunk<E>(): Int throws E;
let run<E>(t: Thunk<E>): Int throws E { t() catch (e) { throw e } }
class Holder<E>(public t: Thunk<E>) {
  public get(): Int throws E { t() catch (e) { throw e } }
}
let s1(): Int { again<String> { 1 } }
let v1<T>(x: T): Int { throw x }
console.log("${again { find("a") } orelse -1} ${named { find("b") }}");
console.log("${run(fn (): Int throws Missing { find("c") }) orelse -3} ${new Holder<Missing>(fn (): Int throws Missing { 4 }).get() orelse -4}");
--- settled
