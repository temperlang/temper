=== a failure parameter solved two ways is their join
// Two arguments that fail differently solve one failure parameter as
// their join: the sealed type both are under (j1), or else the root,
// `Error`, which only a handler takes (j3, j4).
sealed interface AppError extends Error {}
class Missing(public key: String) extends AppError {}
class Bad(public why: String) extends AppError {}
sealed interface OtherError extends Error {}
class Other() extends OtherError {}
let find(key: String): Int throws Missing {
  if (key != "one") { throw new Missing(key) }
  1
}
let check(key: String): Int throws Bad {
  if (key != "one") { throw new Bad(key) }
  1
}
let other(key: String): Int throws Other { throw new Other() }
let both<E>(a: fn (String): Int throws E, b: fn (String): Int throws E, key: String): Int throws E {
  a(key) + b(key)
}
let j1(key: String): Int throws AppError { both(find, check, key) }
let j2(key: String): Int throws Missing { both(find, check, key) }
let j3(key: String): Int { both(find, other, key) catch (e) { when (e) { is Missing -> -1; else -> -2 } } }
let j4(key: String): Int { both(find, other, key) }
let j5(key: String): Int { both(find, fn (k: String): Int { 2 }, key) orelse -3 }
console.log("${j1("one")} ${j1("two") orelse -5} ${j3("two")} ${j3("one")} ${j5("one")}");
