      (Call throws Int NotFound:1)
      (Block
        (If (Call > n:7 1) (Block (Call panic)) (Block))
        (If
          (Call > n:7 0)
          (Block (Fail (Call new NotFound:1 "n")) #void)
          (Block))
        n:7)))
  (Call
    (Call . console \log)
    (Call cat (Orelse (Call risky:2 1) (Block (Call - 1)))))
  (Let ^r:3 (Orelse (Call risky:2 2) (Block (Call - 1))))
  (Call (Call . console \log) (Call cat "after " r:3))
  #void)
