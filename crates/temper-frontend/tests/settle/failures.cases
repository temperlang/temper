        (If (Call == key:10 "a") (Block (Return @52 1) #void) (Block))
        (Fail (Call new NotFound:0 key:10))
        #void)))
  (Let
    ^sum:2
    (Fn
      (Let ^a:11 String)
      (Let ^b:12 String)
      (Call throws Int NotFound:0)
      (Block
        (Let ^x:13 (Call lookup:1 a:11))
        (Let ^y:14 (Call lookup:1 b:12))
        (Call + x:13 y:14))))
  (Let ^found:3 (Orelse (Call lookup:1 "a") (Call - 1)))
  (Let ^m:4 (Orelse (Call lookup:1 "b") (Block (Call - 1))))
  (Let
    ^n:5
    (Orelse
      (Call lookup:1 "q")
      (Block
        (Let ^e:15 (Call caught))
