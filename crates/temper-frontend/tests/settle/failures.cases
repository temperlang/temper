    (Fn
      (Let ^key:12 String)
      (Call throws Int NotFound:1)
      (Block
        (If (Call == key:12 "a") (Block (Return @98 1) #void) (Block))
        (Fail (Call new NotFound:1 key:12))
        #void)))
  (Let
    ^sum:3
    (Fn
      (Let ^a:13 String)
      (Let ^b:14 String)
      (Call throws Int NotFound:1)
      (Block
        (Let ^x:15 (Call lookup:2 a:13))
        (Let ^y:16 (Call lookup:2 b:14))
        (Call + x:15 y:16))))
  (Let ^found:4 (Orelse (Call lookup:2 "a") (Call - 1)))
  (Let ^m:5 (Orelse (Call lookup:2 "b") (Block (Call - 1))))
  (Let
    ^n:6
    (Orelse
      (Call lookup:2 "q")
      (Block
        (Let ^e:17 (Call caught))
        (Call (Call . console \log) (Call . e:17 \key))
        0)))
  (Let
    ^total:7
    (Orelse
      (Call sum:3 "a" "a")
      (Block
        (Let ^e:18 (Call caught))
        (Call (Call . console \log) (Call . e:18 \key))
        0)))
  (Call (Call . console \log) (Call cat found:4 " " total:7))
  (Let
    ^k:8
    Int
    (Orelse (Call lookup:2 "q") (Block (Let ^e:19 (Call caught)) e:19)))
