=== a throw in a handler takes the failure it handles as its cause
sealed interface AppError extends Error {}
class NotFound(public key: String) extends AppError {}
class LookupFailed(public name: String) extends AppError {}
let lookup(key: String): Int throws NotFound { throw new NotFound(key) }
let setting(name: String): Int throws LookupFailed {
  lookup(name) catch { throw new LookupFailed(name) }
}
let parsed(text: String): Int throws LookupFailed {
  text.toInt32() orelse throw new LookupFailed(text)
}
let looped(names: List<String>): Int throws LookupFailed {
  lookup("x") catch {
    for (let n of names) { throw new LookupFailed(n); }
    -1
  }
}
let called(): Int throws LookupFailed {
  let thrower(): Int throws LookupFailed { throw new LookupFailed("f") }
  lookup("c") catch { thrower() }
}
let again(): Int throws NotFound { lookup("k") catch (e) { throw e } }
let show(e: Error): String { "${e.message} <- ${e.cause?.message ?? "nothing"}" }
setting("port") catch (e) { console.log(show(e)); 0 };
parsed("x") catch (e) { console.log(show(e)); 0 };
looped(["a"]) catch (e) { console.log(show(e)); 0 };
called() catch (e) { console.log(show(e)); 0 };
again() catch (e) { console.log(show(e)); 0 };
console.log(show(new NotFound("new")));
--- settled
