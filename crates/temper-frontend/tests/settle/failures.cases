    (Fn
      (Let ^key:13 String)
      (Call throws Int Missing:1)
      (Block (Fail (Call new Missing:1 key:13)))))
  (Let
    ^again:3
    (Fn
      (TypeParam ^E:14)
      (Let ^f:15 (Call FnType (Call throws Int E:14)))
      (Call throws Int E:14)
      (Block
        (Orelse
          (Call f:15)
          (Block
            (Let ^e:16 (Call caught))
            (Call
              (Call . console \log)
              (Call cat "again " (Call . e:16 \message)))
            (Fail e:16))))))
  (Let
    ^named:4
    (Fn
      (TypeParam ^E:17)
      (Let ^f:18 (Call FnType (Call throws Int E:17)))
      String
      (Block
