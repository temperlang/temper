=== a failure needs its type in the function's
class NotFound(public key: String) extends Error {}
class Other extends Error {}
let lookup(key: String): Int throws NotFound { throw new NotFound(key) }
let a(): Int { lookup("a") }
let b(): Int { throw new NotFound("b") }
let c(): Int throws Other { lookup("c") }
let d(): Int throws Other { throw new NotFound("d") }
let e(): Int { lookup("e") orelse 0 }
let f(): Int throws Other { lookup("f") catch { throw new Other() } }
let g(): Int throws Other { lookup("g") catch (x) { console.log(x.key); throw new Other() } }
let h(): Int { do { lookup("h") } catch { 0 } }
