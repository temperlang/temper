=== failure types: non-generic, sealed interfaces, one failure parent
sealed interface A1 extends Error {}
sealed interface A2 extends Error {}
interface Plain {}
class Box<T>(public t: T) extends Error {}
interface Loose extends Error {}
interface Looser extends A1 {}
sealed interface Fine extends A1 {}
class Both extends A1, A2 {}
class One extends A1, Plain {}
class Deep extends Fine, A2 {}
