=== a generator may throw any error, which next passes on
// A generator body may declare what it throws; its factory then makes a
// `Generator<Y>`, whose `next()` throws `Error`, any error, which
// callers handle. One that can't fail makes a `SafeGenerator<Y>`, whose
// `next()` throws `Error` too, as `Generator`'s, while `nextSafe()`
// can't fail. A body that declares `throws Error` passes on an inner
// generator's failure.
sealed interface GenError extends Error {}
class TooBig(public n: Int) extends GenError {}
let make(body: fn (Int): Generator<Int>): Generator<Int> { body(3) }
let g = make { (limit: Int): GeneratorResult<Int> throws TooBig extends GeneratorFn =>
  var i = 1;
  while (true) {
    if (i > limit) { throw new TooBig(i); }
    yield i;
    i += 1;
  }
};
let show(g: Generator<Int>): String {
  let r = g.next() catch (e) {
    return when (e) {
      is TooBig -> "too big ${e.n}";
      else -> e.message;
    };
  };
  when (r) {
    is ValueResult<Int> -> "value ${r.value}";
    else -> "done";
  }
}
for (var n = 0; n < 5; n += 1) { console.log(show(g)); }
let safe(body: fn (): SafeGenerator<Int>): SafeGenerator<Int> { body() }
let s = safe { (): GeneratorResult<Int> extends GeneratorFn => yield 7; };
let first(g: SafeGenerator<Int>): Boolean { g.nextSafe() is ValueResult<Int> }
console.log("${first(s)} ${show(s)}");
let twice(inner: Generator<Int>): Generator<Int> {
  make { (n: Int): GeneratorResult<Int> throws Error extends GeneratorFn =>
    while (true) {
      let r = try inner.next();
      if (r is ValueResult<Int>) { yield r.value * n; } else { break; }
    }
  }
}
let t = twice(make { (limit: Int): GeneratorResult<Int> throws TooBig extends GeneratorFn =>
  yield 1;
  throw new TooBig(limit);
});
for (var n = 0; n < 3; n += 1) { console.log(show(t)); }
