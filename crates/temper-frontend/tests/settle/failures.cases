=== core's failure types: MissingKey under CoreError, joined with others' as Error
sealed interface AppError extends Error {}
class NotFound(public key: String) extends AppError {}
let m = new Map([new Pair("a", 1)]);
let lookup(key: String): Int throws NotFound { throw new NotFound(key) }
let viaRoot(k: String): Int throws CoreError { m[k] }
let own(k: String): Int throws MissingKey { throw new MissingKey(k) }
let which(k: String): String {
  do { lookup(k); m[k].toString() } catch (e) {
    when (e) { is MissingKey -> "missing"; is NotFound -> "not found ${e.key}"; else -> "other" }
  }
}
let c: CoreError? = do { viaRoot("z"); null } catch (e) { e };
let n: NotFound? = do { m["z"]; null } catch (e) { e };
console.log("${which("a")} ${c is MissingKey} ${(own("q") catch (e) { e.message })}");
viaRoot("y");
