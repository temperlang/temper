  (Interface ^AppError:0 Error)
  (Class ^Hidden:1 AppError:0)
  (Interface ^Secret:2 Error)
  (Class ^Told:3 Secret:2)
  (Class ^Shown:4 AppError:0)
  (Let
    ^find:5
    (Fn (Call throws Int Hidden:1) (Block (Fail (Call new Hidden:1)))))
  (Let ^seek:6 (Fn (Call throws Int Secret:2) (Block (Fail (Call new Told:3)))))
  (Let ^fine:7 (Fn (Call throws Int Shown:4) (Block (Fail (Call new Shown:4)))))
  (Let
    ^apply:8
    (Fn
      (Let ^f:16 (Call FnType (Call throws Int Hidden:1)))
      Int
      (Block (Orelse (Call f:16) 0))))
  (Class
    ^Finder:9
