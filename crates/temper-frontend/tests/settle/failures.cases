=== a failure's message: its type's words and public fields, or its own
class NotFound(public key: String) extends Error {}
class EmptyText extends Error {}
class HTTPFailure(public code: Int, public retry: Boolean) extends Error {}
class Range(public low: Int, public high: Float64, private secret: String) extends Error {
  public note: String? = null;
}
class Expired(public days: Int) extends Error {
  public get message(): String { "expired ${days} days ago" }
}
class Wrapped(public inner: NotFound, public all: List<Int>) extends Error {}
sealed interface SignError extends Error {}
class BadSign(public text: String) extends SignError {}
console.log(new NotFound("y").message);
console.log(new EmptyText().message);
console.log(new HTTPFailure(503, true).message);
console.log(new Range(1, 2.5, "s").message);
console.log(new Expired(3).message);
console.log(new Wrapped(new NotFound("z"), [1]).message);
let s: SignError = new BadSign("?");
let e: Error = new Expired(1);
console.log("${s.message}; ${e.message}");
