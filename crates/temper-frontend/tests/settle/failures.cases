=== core's functions that take callbacks fail as their callbacks do
// RFC 164: core's `Listed` and `Mapped` functions that take callbacks
// are generic over what the callbacks may fail with, as `map` is, so
// each passes it on and can't fail where its callback can't.
sealed interface AppError extends Error {}
class Missing(public key: String) extends AppError {}
let find(key: String): Int throws Missing {
  if (key == "x") { throw new Missing(key) }
  if (key == "a") { 1 } else { 2 }
}
let ks = ["a", "bb", "x"];
let filtered(): List<String> throws Missing { ks.filter { k => find(k) > 1 } }
let reduced(): String throws Missing { ks.reduce { a, b => if (find(b) > 0) { "${a}${b}" } else { a } } }
let reducedFrom(): Int throws Missing { ks.reduceFrom(0) { n, k => n + find(k) } }
let joined(): String throws Missing { ks.join("+") { k => find(k).toString() } }
let sorted(): List<String> throws Missing { ks.sorted { a, b => find(a) - find(b) } }
let sortedSafe(): List<Int> { [2, 1].sorted { a, b => a - b } }
let sortedHere(): Void throws Missing {
  let b = new ListBuilder<String>();
  b.addAll(ks);
  b.sort { x, y => find(y) - find(x) }
}
let each(): Void throws Missing { ks.forEach { k => console.log("each ${find(k)}"); } }
let codes(): Void throws Missing {
  "ab".forEach { c => console.log("code ${find(if (c == 97) { "a" } else { "x" })}"); }
}
let entries(): List<Int> throws Missing {
  let m = new Map([new Pair("a", 1), new Pair("x", 2)]);
  m.forEach { k, v => console.log("entry ${k} ${v}"); }
  m.toListWith { k, v => find(k) + v }
}
let safe(): String { ks.filter { k => k != "x" }.join(",") { k => k } }
console.log("${filtered().length orelse -1} ${reduced() orelse "r"} ${reducedFrom() orelse -2} ${joined() orelse "j"}");
console.log("${sorted().length orelse -3} ${sortedSafe().join(",") { k => k.toString() }} ${safe()}");
sortedHere() orelse console.log("sort failed");
each() orelse console.log("each failed");
codes() orelse console.log("codes failed");
entries() orelse console.log("entries failed");
