    (Param ^t:28 (Call <> Thunk:5 E:26))
    (Method
      ^get:29
      (Fn
        (Call throws Int E:26)
        (Block
          (Orelse (Call t:28) (Block (Let ^e:30 (Call caught)) (Fail e:30)))))))
  (Let ^s1:8 (Fn Int (Block (Call again:3 \typeArg String (Fn (Block 1))))))
  (Let ^v1:9 (Fn (TypeParam ^T:31) (Let ^x:32 T:31) Int (Block (Fail x:32))))
