=== an export's failure type must be exported too
// As any type in an exported signature (classes.cases, "exports that
// depend on non-exported types"): a public signature failing with an
// unexported type gives host code a failure it can't name.
export sealed interface AppError extends Error {}
class Hidden extends AppError {}
sealed interface Secret extends Error {}
class Told extends Secret {}
export class Shown extends AppError {}
export let find(): Int throws Hidden { throw new Hidden() }
export let seek(): Int throws Secret { throw new Told() }
export let fine(): Int throws Shown { throw new Shown() }
export let apply(f: fn (): Int throws Hidden): Int { f() orelse 0 }
export class Finder {
  public find(): Int throws Hidden { throw new Hidden() }
  private quiet(): Int throws Hidden { throw new Hidden() }
}
// Not exports: private functions may fail with private types.
let local(): Int throws Hidden { throw new Hidden() }
console.log("${find() orelse -1} ${local() orelse -2}");
--- settled
(Block
  (Interface ^AppError:0 Error)
  (Class ^Hidden:1 AppError:0)
  (Interface ^Secret:2 Error)
  (Class ^Told:3 Secret:2)
  (Class ^Shown:4 AppError:0)
  (Let
    ^find:5
    (Fn (Call throws Int Hidden:1) (Block (Fail (Call new Hidden:1)))))
  (Let ^seek:6 (Fn (Call throws Int Secret:2) (Block (Fail (Call new Told:3)))))
