  (Class ^NotFound:0 Error (Param ^key:10 String))
  (Class ^LookupFailed:1 Error (Param ^name:12 String))
  (Let
    ^lookup:2
    (Fn
      (Let ^key:13 String)
      (Call throws Int NotFound:0)
      (Block (Fail (Call new NotFound:0 key:13)))))
  (Let
    ^setting:3
    (Fn
      (Let ^name:14 String)
      (Call throws Int LookupFailed:1)
      (Block
        (Orelse
          (Call lookup:2 name:14)
          (Block (Fail (Call new LookupFailed:1 name:14)))))))
