=== a catch binding has its operand's failure type, the join of several
sealed interface AppError extends Error {}
class NotFound(public key: String) extends AppError {}
sealed interface SignError extends Error {}
class EmptyText extends SignError {}
class BadSign(public text: String) extends SignError {}
let lookup(key: String): Int throws NotFound { throw new NotFound(key) }
let sign(text: String): Int throws BadSign { throw new BadSign(text) }
let empty(): Int throws EmptyText { throw new EmptyText() }
let a: SignError? = do { sign("x"); empty(); null } catch (e) { e };
let b: SignError? = do { sign("x"); lookup("y"); null } catch (e) { e };
let c: Error? = do { sign("x"); lookup("y"); null } catch (e) { e };
let d = lookup("a") catch (e) { do { sign(e.key) } catch (f) { console.log(f.text); 0 } };
