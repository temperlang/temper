  (Interface ^Loose:5 Error)
  (Interface ^Looser:6 A1:0)
  (Interface ^Fine:7 A1:0)
  (Class ^Both:8 A1:0 A2:1)
  (Class ^One:9 A1:0 Plain:3)
  (Class ^Deep:10 Fine:7 A2:1)
  (Class ^Direct:11 Error)
  (Interface ^Under:12 Error A1:0)
  (Class ^At:13 Positioned:2 (Param ^position:32 Int))
  (Let
    ^at:14
    (Fn (Call throws Int Positioned:2) (Block (Fail (Call new At:13 4)))))
  (Call
    (Call . console \log)
    (Call
      (Call
        .
        (Orelse
          (Call at:14)
          (Block (Let ^e:33 (Call caught)) (Call . e:33 \position)))
        \toString)))
  #void)
