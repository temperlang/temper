// `for … of` on a class's own `forEach`, which might call the body
// at another time, isn't taken for a loop.
class Later {
  private xs: List<String>;
  public constructor(xs: List<String>) { this.xs = xs; }
  public forEach(f: fn (String): Void): Void { for (let x of xs) { f(x); } }
}
