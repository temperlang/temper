=== content tags in loops and jumps
// A toy content tag, following Kotlin's pass's conventions: a value
// is escaped as [x], and inside single quotes as ([x]), and a fixed "!"
// becomes a mark.
sealed interface Problem extends Error {}
class Oops() extends Problem {}
export interface Effect { enactOn(c: Buffer): Void; }
export class AppendParseEffect(public text: String) extends Effect {
  public enactOn(c: Buffer): Void { c.append(text) }
}
export class EventParseEffect(public event: Mark) extends Effect {
  public enactOn(c: Buffer): Void { c.mark(event) }
}
export class Mark(public label: String) {}
export class After(public effects: List<Effect>, public stateAfter: Boolean) {}
export class Propagator(public quote: String) {}
export let Callout = fn (String, Boolean): Void;
let ignore(problem: String, isError: Boolean): Void { if (isError) { console.log(problem); } }
export let propagateOver(
  p: Propagator, before: Boolean, known: String?,
  same: fn (Boolean, Boolean): Boolean, callout: Callout,
): After {
  if (known == null) { return new After([], before); }
  if (known == "!") { return new After([new EventParseEffect(new Mark("bang"))], before); }
  let angles = known.split("<").length;
  if (angles > 1) { callout("angle bracket in fixed text", false); }
  if (!same(before, before)) { callout("states differ from themselves", true); }
  let quotes = known.split(p.quote).length - 1;
  new After([new AppendParseEffect(known)], if (quotes % 2 == 1) { !before } else { before })
}
// Escapers' overrides answer to `apply`, as their interface marks it.
export interface Escaper {
  @overload("apply")
  applyString(x: String): String;
}
export class TextEscaper extends Escaper {
  public static instance: TextEscaper = new TextEscaper();
  public applyString(x: String): String { "[${x}]" }
}
export class QuoteEscaper extends Escaper {
  public static instance: QuoteEscaper = new QuoteEscaper();
  public applyString(x: String): String { "(${x})" }
}
// Composed escapers apply `first`, then `second`.
export class Both(public first: Escaper, public second: Escaper) extends Escaper {
  public applyString(x: String): String { second.applyString(first.applyString(x)) }
}
export class Picker(public strict: Boolean) {
  public escaperFor(inQuote: Boolean, callout: Callout): Escaper {
    if (strict && inQuote) { callout("a value in quotes", false); }
    if (inQuote) { new Both(TextEscaper.instance, QuoteEscaper.instance) } else { TextEscaper.instance }
  }
}
export class Buffer {
  private sb: StringBuilder = new StringBuilder();
  public append(x: String): Void { sb.append(x) }
  public mark(m: Mark): Void { sb.append("{${m.label}}") }
  public toString(): String { sb.toString() }
}
export interface ContextualAutoescapingAccumulator {
  public get accumulated(): String;
}
export class Quoting extends ContextualAutoescapingAccumulator {
  public static newCollector(): Buffer { new Buffer() }
  public static initialState(): Boolean { false }
  public static propagator(): Propagator { new Propagator("'") }
  public static picker(): Picker { new Picker(false) }
  public static sameStatePredicate(): fn (Boolean, Boolean): Boolean {
    fn (a: Boolean, b: Boolean): Boolean { a == b }
  }
  public static mergeStates(a: Boolean, b: Boolean, callout: Callout): Boolean {
    if (a != b) { callout("branches end in different contexts", true); }
    a
  }
  public static checkEndState(inQuote: Boolean, callout: Callout): Void {
    if (inQuote) { callout("ends inside quotes", true); }
  }
  public static fromCollector(c: Buffer): String { c.toString() }
  public static enact(m: Mark, c: Buffer): Void { c.mark(m) }
  private var inQuote: Boolean = false;
  private collector: Buffer = new Buffer();
  public appendSafe(x: String): Void {
    let after = propagateOver(Quoting.propagator(), inQuote, x, Quoting.sameStatePredicate(), ignore);
    inQuote = after.stateAfter;
    for (let e of after.effects) { e.enactOn(collector); }
  }
  public append(x: String): Void {
    let escaped = Quoting.picker().escaperFor(inQuote, ignore).apply(x);
    collector.append(escaped);
  }
  public get accumulated(): String { collector.toString() }
}
let q = Quoting;

// Each use below is logged beside the same calls written out by hand
// with one more read of the accumulator, which no fold takes, so it
// propagates at run time: the two agree.

// Loops whose passes end in the context they start in fold once; the
// state after them is the state before.
let listed(xs: List<String>): String {
  q"""
    ~(
    : for (let x of xs) {
    ~ '${x}' ${x}
    : }
    ~)
}
let listedRt(xs: List<String>): String {
  do {
    let t = new Quoting();
    t.appendSafe("(");
    for (let x of xs) { t.appendSafe(" '"); t.append(x); t.appendSafe("' "); t.append(x); }
    t.appendSafe(")");
    let u = t;
    t.accumulated
  }
}
console.log("for of ${listed(["a", "b"])} ${listedRt(["a", "b"])}");
// `break` and `continue` in the context the loop starts in.
let counted(n: Int, x: String): String {
  q"""
    : var i = 0;
    : while (i < n) {
    : i += 1;
    : if (i == 2) { continue; }
    ~'${x}'
    : if (i == 4) { break; }
    ~${x},
    : }
    ~.
}
let countedRt(n: Int, x: String): String {
  do {
    let t = new Quoting();
    var i = 0;
    while (i < n) {
      i += 1;
      if (i == 2) { continue; }
      t.appendSafe("'"); t.append(x); t.appendSafe("'");
      if (i == 4) { break; }
      t.append(x); t.appendSafe(",");
    }
    t.appendSafe(".");
    let u = t;
    t.accumulated
  }
}
console.log("while ${counted(5, "c")} ${countedRt(5, "c")}");
let stepped(n: Int, x: String): String {
  q"""
    : for (var i = 0; i < n; i++) {
    ~(${x})
    : }
    : var j = 0;
    : do {
    ~'${x}';
    : j += 1;
    : } while (j < n);
}
let steppedRt(n: Int, x: String): String {
  do {
    let t = new Quoting();
    for (var i = 0; i < n; i++) { t.appendSafe("("); t.append(x); t.appendSafe(")"); }
    var j = 0;
    do { t.appendSafe("'"); t.append(x); t.appendSafe("';"); j += 1; } while (j < n);
    let u = t;
    t.accumulated
  }
}
console.log("for, do ${stepped(2, "d")} ${steppedRt(2, "d")} ${stepped(0, "d")} ${steppedRt(0, "d")}");
// Nested loops, and labeled jumps, that agree. Logic lines don't take
// labels, so these blocks are written as tagged strings settle, which
// folds alike.
let grid(n: Int, x: String): String {
  do {
    let t = new Quoting();
    outer: for (var i = 0; i < n; i++) {
      for (var j = 0; j < n; j++) {
        if (j > i) { continue outer; }
        if (i == 2) { break outer; }
        t.appendSafe("'"); t.append(x); t.appendSafe("'"); t.append(j.toString());
      }
      t.appendSafe(";");
    }
    t.accumulated
  }
}
let gridRt(n: Int, x: String): String {
  do {
    let t = new Quoting();
    outer: for (var i = 0; i < n; i++) {
      for (var j = 0; j < n; j++) {
        if (j > i) { continue outer; }
        if (i == 2) { break outer; }
        t.appendSafe("'"); t.append(x); t.appendSafe("'"); t.append(j.toString());
      }
      t.appendSafe(";");
    }
    let u = t;
    t.accumulated
  }
}
console.log("nested ${grid(3, "e")} ${gridRt(3, "e")}");

// A path that leaves the tagged string, by `return`, `throw new Oops()`, or a
// jump to a loop around it, never reads the accumulator again, so the
// state it leaves in joins nothing, even inside quotes.
let attribute(c: Boolean, x: String): String {
  q"""
    ~a='
    : if (c) { return "none"; }
    ~${x}'
}
let attributeRt(c: Boolean, x: String): String {
  do {
    let t = new Quoting();
    t.appendSafe("a='");
    if (c) { return "none"; }
    t.append(x);
    t.appendSafe("'");
    let u = t;
    t.accumulated
  }
}
console.log("return ${attribute(false, "f")} ${attributeRt(false, "f")} ${attribute(true, "f")} ${attributeRt(true, "f")}");
let bubbled(c: Boolean, x: String): String throws Oops {
  q"""
    : if (c) {
    ~'
    : throw new Oops();
    : }
    ~${x}
}
let bubbledRt(c: Boolean, x: String): String throws Oops {
  do {
    let t = new Quoting();
    if (c) { t.appendSafe("'"); throw new Oops(); }
    t.append(x);
    let u = t;
    t.accumulated
  }
}
console.log("bubble ${bubbled(false, "g") orelse "failed"} ${bubbledRt(false, "g") orelse "failed"} ${bubbled(true, "g") orelse "failed"}");
let around(n: Int, x: String): String {
  var r = "";
  for (var i = 0; i < n; i++) {
    let s = q"""
      ~'
      : if (i == 0) { continue; }
      : if (i == 2) { break; }
      ~${x}'
    ;
    r = "${r}${s}";
  }
  r
}
let aroundRt(n: Int, x: String): String {
  var r = "";
  for (var i = 0; i < n; i++) {
    let s = do {
      let t = new Quoting();
      t.appendSafe("'");
      if (i == 0) { continue; }
      if (i == 2) { break; }
      t.append(x);
      t.appendSafe("'");
      let u = t;
      t.accumulated
    };
    r = "${r}${s}";
  }
  r
}
console.log("around ${around(3, "h")} ${aroundRt(3, "h")}");

// Left to run time: a loop whose body changes the context, as by
// opening a quote, or a `continue` that skips closing one.
let opened(xs: List<String>): String {
  q"""
    : for (let x of xs) {
    ~'${x}
    : }
}
let openedRt(xs: List<String>): String {
  do {
    let t = new Quoting();
    for (let x of xs) { t.appendSafe("'"); t.append(x); }
    let u = t;
    t.accumulated
  }
}
console.log("opened ${opened(["i", "j", "k"])} ${openedRt(["i", "j", "k"])}");
let skipped(n: Int, x: String): String {
  q"""
    : for (var i = 0; i < n; i++) {
    ~'${x}
    : if (i == 0) { continue; }
    ~'
    : }
    ~${x}
}
let skippedRt(n: Int, x: String): String {
  do {
    let t = new Quoting();
    for (var i = 0; i < n; i++) {
      t.appendSafe("'"); t.append(x);
      if (i == 0) { continue; }
      t.appendSafe("'");
    }
    t.append(x);
    let u = t;
    t.accumulated
  }
}
console.log("skipped ${skipped(3, "l")} ${skippedRt(3, "l")}");
// The inner loop of two changes the context.
let nested(n: Int, x: String): String {
  q"""
    : for (var i = 0; i < n; i++) {
    : for (var j = 0; j < i; j++) {
    ~'${x}
    : }
    ~;
    : }
}
let nestedRt(n: Int, x: String): String {
  do {
    let t = new Quoting();
    for (var i = 0; i < n; i++) {
      for (var j = 0; j < i; j++) { t.appendSafe("'"); t.append(x); }
      t.appendSafe(";");
    }
    let u = t;
    t.accumulated
  }
}
console.log("nested ${nested(3, "m")} ${nestedRt(3, "m")}");
// A labeled `continue` inside quotes.
let resumed(n: Int, x: String): String {
  do {
    let t = new Quoting();
    outer: for (var i = 0; i < n; i++) {
      for (var j = 0; j < n; j++) {
        t.appendSafe("'");
        if (j == 1) { continue outer; }
        t.append(x); t.appendSafe("'");
      }
    }
    t.append(x);
    t.accumulated
  }
}
let resumedRt(n: Int, x: String): String {
  do {
    let t = new Quoting();
    outer: for (var i = 0; i < n; i++) {
