    let t = new Quoting();
    for (var i = 0; i < n; i++) {
      t.appendSafe("'"); t.append(x);
      if (i == 1) { break; }
      t.appendSafe("'");
    }
    t.append(x);
    let u = t;
    t.accumulated
  }
}
