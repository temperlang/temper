// A jump inside an appended value carries the state from before the
// append: out of a labeled block inside quotes, which the tag reports as
// for branches, and a `continue` inside quotes, so neither folds.
let valued(c: Boolean, x: String): String {
  do {
    let t = new Quoting();
    lbl: do {
      t.appendSafe("'");
      t.append(if (c) { break lbl; } else { x });
      t.appendSafe("'");
    }
    t.append(x);
    t.accumulated
  }
}
