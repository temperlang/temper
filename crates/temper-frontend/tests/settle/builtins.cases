      (Fn
        (Let ^a:15 Int)
        (Call throws Void Oops:1)
        (Block
          (If (Call < a:15 0) (Block (Fail (Call new Oops:1))) (Block))
          (Assign q:13 a:15)
          #void))))
  (Class ^D:3 (Param ^y:17 Int))
  (Let ^n1:4 (Fn C:2 (Block (Call new C:2 1))))
