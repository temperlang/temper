=== operators unchecked where types aren't known as Kotlin knows them
let a2(f: fn (): Int): Int { 1 + f }
let a3(x: AnyValue): Int { x * 2 }
let a4(x: Int): Int { x + panic() }
let a5(x: Int, y: Int?): Boolean { x == y }
let a6(x: Int, y: String?): Boolean { x == y }
let a8(x: String): String { var y = x; y++; y }
let a9(x: Int): Boolean { x == null }
--- settled
(Block
  (Let ^a2:0 (Fn (Let ^f:7 (Call FnType Int)) Int (Block (Call + 1 f:7))))
  (Let ^a3:1 (Fn (Let ^x:8 AnyValue) Int (Block (Call * x:8 2))))
  (Let ^a4:2 (Fn (Let ^x:9 Int) Int (Block (Call + x:9 (Call panic)))))
  (Let
    ^a5:3
    (Fn
      (Let ^x:10 Int)
      (Let ^y:11 (Call ? Int))
      Boolean
      (Block (Call == x:10 y:11))))
  (Let
    ^a6:4
    (Fn
      (Let ^x:12 Int)
      (Let ^y:13 (Call ? String))
      Boolean
      (Block (Call == x:12 y:13))))
  (Let
    ^a8:5
    (Fn
      (Let ^x:14 String)
      String
      (Block
        (Var ^y:15 x:14)
        (Block (Let ^t#16 y:15) (Assign y:15 (Call + t#16 1)) t#16)
        y:15)))
  (Let ^a9:6 (Fn (Let ^x:17 Int) Boolean (Block (Call == x:17 null)))))

=== what may fail where it can't
sealed interface Problem extends Error {}
class Oops() extends Problem {}
let d(a: Int, b: Int): Int throws Oops { if (b == 0) { throw new Oops() } else { a / b } }
let g(x: Int): Int throws Oops { if (x == 0) { throw new Oops() } else { x } }
let a1(x: Int): Int { if (x < 0) { throw new Oops() } else { x } }
let a2(): Int { return throw new Oops(); }
let a3(x: Int): Int { g(x) }
let a4(h: fn (Int): Int throws Oops): Int { h(1) }
let a5(x: Int): Int { let k = g; k(x) }
let a6(a: Int, b: Int): Int { d(a, b) }
let a7(a: Int): Int { d(a, 0) }
let a8(a: Int): Int { a % -3 }
let a9(a: Float64): Float64 { a / 2.0 }
let b1(a: Int): Void { a % a; }
let b2(a: Int): Void { console.log("${d(a, a)}") }
let b3(a: Int): Int { if (d(a, a) == 1) { 1 } else { 0 } }
let b4(a: Int): Int { do { let f(): Int { d(a, a) }; f() } orelse 0 }
let b5(a: Int): Int { do { d(a, a) } orelse throw new Oops() }
let b6(a: Int): Void { for (let x of [1]) { console.log("${d(x, a)}"); } }
let b7(a: Int): Int { let f = fn (): Int { d(a, a) }; f() }
let b8(a: Int): Int { let f(y: Int = d(a, a)): Int { y }; f() }
let b9(a: Int): Int { if (true) { d(a, a) } else { 0 } }
class D {
  private var q: Int = 0;
  public constructor(a: Int) { q = d(a, a); }
  public m(a: Int): Int { a % a }
  public get p(): Int { d(q, q) }
  public set p(v: Int): Void { q = d(v, v); }
}
--- settled
