=== what may fail: constructors that say so
// Kotlin doesn't fold a constructor's call, so reports one with constant
// arguments too; not one with the wrong number of arguments.
sealed interface Problem extends Error {}
class Oops() extends Problem {}
class C {
  private var q: Int = 0;
  public constructor(a: Int): Void throws Oops {
    if (a < 0) { throw new Oops() }
    q = a;
  }
}
class D(public y: Int) {}
let n1(): C { new C(1) }
let n2(a: Int): C { new C(a) }
let n3(a: Int): C? { do { new C(a) } orelse null }
let n4(a: Int): C throws Oops { new C(a) }
let n5(): D { new D(1) }
let n6(): C { new C(1, 2) }
--- settled
(Block
  (Interface ^Problem:0 Error)
  (Class ^Oops:1 Problem:0)
  (Class
    ^C:2
    (Var private ^q:13 Int 0)
    (Constructor
