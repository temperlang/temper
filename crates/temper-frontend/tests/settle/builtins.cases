=== what may fail where it can
sealed interface Problem extends Error {}
class Oops() extends Problem {}
let d(a: Int, b: Int): Int throws Oops { if (b == 0) { throw new Oops() } else { a / b } }
let g(x: Int): Int throws Oops { if (x == 0) { throw new Oops() } else { x } }
let n = 2;
let a1(a: Int): Int throws Oops { d(a, a) }
let a2(a: Int): Void throws Oops { throw new Oops() }
let a3(a: Int): Int { (d(a, a)) orelse 0 }
let a5(a: Int): Int { a / -3 }
let a7(a: Int64): Int64 { a % 2i64 }
let a8(a: Int): Int { let k = 3; a % k }
let b1(a: Int): Int { if (false) { throw new Oops() } else { a } }
let b2(a: Int): Int { panic() }
let b3(ls: List<Int>, a: Int): Void throws Oops {
  for (let x of ls) { console.log("${d(x, a)}"); }
}
let b4(a: Int): Void { let f = fn { throw new Oops() }; }
let b5(a: Int): Int { let f(): Int throws Oops { d(a, a) }; f() orelse 0 }
console.log("${d(1, (n - 2))}") orelse console.log("top level");
