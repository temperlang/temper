=== what may fail in operators' arguments
// What may fail in an operator's arguments is reported whether or not
// they fit the variant it picks.
sealed interface Problem extends Error {}
class Oops() extends Problem {}
class K {}
class H {
  @operator("==")
  public eq(other: H): Boolean { true }
}
let mi(n: Int): Int throws Oops { if (n > 0) { 1 } else { throw new Oops() } }
let mf(n: Int): Float64 throws Oops { if (n > 0) { 1.0 } else { throw new Oops() } }
let mk(n: Int): K throws Oops { if (n > 0) { new K() } else { throw new Oops() } }
let a1(n: Int): Int { "a" - mi(n) }
let a2(n: Int): Boolean { "a" == mi(n) }
let a3(k: K, n: Int): Boolean { k == mi(n) }
let a4(k: K, n: Int): Boolean { mk(n) == k }
let a5(n: Int): Int { mi(n) - "a" }
let a6(n: Int): Boolean { 1 == mk(n) }
let a7(h: H, n: Int): Boolean { h == mk(n) }
let b1(n: Int): Float64 { mf(n) ** "a" }
let b2(n: Int): Float64 { "a" ** mf(n) }
let b3(n: Int): Boolean { !mi(n) }
let b4(n: Int): Float64 { mi(n) ** mf(n) }
