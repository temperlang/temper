=== locals assigned on every path, as Kotlin Temper's UseBeforeInit accepts them
let d(a: Int, b: Int): Int throws Bubble { if (b == 0) { bubble() } else { a / b } }
let branches(b: Boolean): Int {
  let x;
  if (b) { x = 1; } else { x = 2; }
  let y;
  if (b) { y = 1; } else { return 0; }
  let z;
  when (b) {
    true -> z = 1;
    else -> z = 2;
  }
  let u;
  if (b) { u = 1; } else { panic(); }
  x + y + z + u
}
let bubbles(b: Boolean): Int throws Bubble {
  let v;
  if (b) { v = 1; } else { bubble(); }
  v
}
let loops(b: Boolean): Int {
  let x;
  do { x = 3; } while (x < 2);
  var w;
  while (true) { w = 1; break; }
  var n;
  for (;;) { if (b) { n = 1; break; } }
  let k;
  for (var i = 0; i < 3; i += 1) {
    if (i == 1) { continue; }
  }
  k = 4;
  x + w + n + k
}
let failing(n: Int): Int {
  let q;
  do { q = d(10, n); } orelse do { q = 2; }
  let r;
  do { r = d(4, 2); } orelse panic();
  q + r
}
let later(): Int {
  let x;
  let f(): Int { x };
  x = 1;
  f()
}
let x;
if (branches(true) > 0) { x = 1; } else { x = 2; }
console.log("${x} ${branches(true)} ${loops(true)} ${failing(0)} ${later()} ${bubbles(true) orelse 0}");
