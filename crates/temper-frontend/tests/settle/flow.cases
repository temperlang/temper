=== calls that never return end their paths, as panic() does
// A call of a function whose result is Never<T> (any T, Void too) ends
// its path, as panic() does: a local assigned on the other paths is
// assigned after it, a null check that leaves through it narrows, and
// code after it is unreachable. Where a value is wanted, it's still its
// type, as Kotlin Temper has it: a Never<Int> fits an Int, but a
// Never<Void> doesn't ("from Void"), at the end of a body, in an orelse,
// a ??, or a when. Kotlin narrows after none of these, nor after
// panic() or return, and checks no definite assignment here.
let stop(): Never<Void> { panic() }
let stopInt(): Never<Int> { panic() }
let stopStr(): Never<String> { panic() }
let p(s: String): Int throws Bubble { s.toInt32() }
let plain(): Void {}
let assigned(b: Boolean): Int {
  let x: Int;
  if (b) { x = 1 } else { stop() }
  x
}
let assignedInt(b: Boolean): Int {
  let x: Int;
  if (b) { x = 1 } else { stopInt() }
  x
}
let unassigned(b: Boolean): Int {
  let x: Int;
  if (b) { x = 1 } else { plain() }
  x
}
let narrowed(s: String?): String {
  if (s == null) { stop() }
  let t: String = s;
  t
}
let narrowedByPanic(s: String?): String {
  if (s == null) { panic() }
  s
}
let endsInt(b: Boolean): Int {
  if (b) { return 1 }
  stopInt()
}
let orElseInt(s: String): Int { p(s) orelse stopInt() }
let coalesced(s: String?): String { s ?? stopStr() }
let whenInt(n: Int): Int { when (n) { 1 -> 2; else -> stopInt() } }
let after(): Int {
  stop();
  5
}
let inLoop(n: Int): Int {
  var i = 0;
  while (i < n) {
    if (i > 3) { stop() }
    i += 1;
  }
  i
}
let endsVoid(b: Boolean): Int {
  if (b) { return 1 }
  stop()
}
let orElseVoid(s: String): Int { p(s) orelse stop() }
let coalescedVoid(s: String?): String { s ?? stop() }
let whenVoid(n: Int): Int { when (n) { 1 -> 2; else -> stop() } }
console.log("${assigned(true)} ${assignedInt(true)} ${narrowed("n")} ${narrowedByPanic("p")}");
console.log("${endsInt(true)} ${orElseInt("4")} ${coalesced("c")} ${whenInt(1)} ${inLoop(2)}");
