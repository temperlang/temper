=== locals read before they're assigned on some path, as Kotlin Temper's UseBeforeInit reports them
// Kotlin also says where the paths that miss it are. An orelse's
// fallback follows what may fail in its body, as the division, but not
// the assignment of s.
let d(a: Int, b: Int): Int throws Bubble { if (b == 0) { bubble() } else { a / b } }
let maybe(b: Boolean): Int {
  let a, c;
  if (b) {
    a = 1;
  } else {
    c = 2;
  }
  a + c
}
let missingElse(b: Boolean): Void {
  let x;
  if (b) {
    x = 1;
  }
  console.log(x.toString());
}
let loops(b: Boolean, xs: List<Int>): Int {
  var w;
  while (b) { w = 1; }
  let y;
  for (let x of xs) { y = x; }
  var z;
  z += 1;
  w + y + z
}
let failing(b: Boolean, n: Int): Int {
  let q;
  let r = do { q = d(10, n); 0 } orelse 2;
  let s;
  (s = n) orelse panic();
  let t;
  when (b) {
    true -> t = 1;
  }
  q + r + s + t
}
// A read reported once per path; a function's own locals are checked,
// its outer function's aren't, wherever it's called.
let once(b: Boolean): Int {
  let u;
  if (b) { u = 1; }
  let f(): Int { u };
  let g(): Int { let v; v };
  u + u + f() + g()
}
console.log(maybe(true).toString());
console.log("after");
