=== nullable locals stay nullable until narrowed
// A nullable local used where a non-null value is wanted is an error,
// as for a parameter of the same type, whatever its value (`k6` to
// `k10`): typing uses types, never values. That holds at top level, in
// loops and closures, after a `var` is assigned, for a field, and in an
// `as` cast.
//
// It's fine once the local is narrowed (a null check, `??`, an early
// exit). A parameter with a default takes any nullable value whose
// non-null type fits, since null selects the default.
let take(n: Int): Void {}
let takeS(s: String): Void {}
let run(f: fn (): Void): Void { f() }
let find(s: String): Int? { if (s == "one") { 1 } else { null } }
class Box(public n: Int?) {}
let top: Int? = null;
let topFound = find("two");
var topVar: Int? = null;
let d1(): Int { let n: Int? = null; n + 1 }
let d2(): Void { let n: Int? = null; take(n) }
let d3(): Void { let s: String? = null; let m: String = s; takeS(m) }
let d4(): Boolean { let s: String? = null; s.isEmpty }
let d5(): Int { let n: Int? = null; n }
let i1(): Int { let n = find("two"); n + 1 }
let i2(): Void { let n = find("two"); take(n) }
let i3(): Void { let n = find("one"); take(n) }
let i4(): Void { take(find("one")) }
let v1(): Void { var n: Int? = null; take(n) }
let v2(): Void { var n = find("two"); n = find("one"); take(n) }
let v3(): Void { var n: Int? = null; n = 2; take(n) }
let l1(): Void { for (var i = 0; i < 2; ++i) { let n = find("two"); take(n) } }
let l2(): Void { let n = find("two"); for (var i = 0; i < 2; ++i) { take(n) } }
let c1(): Int { let n = find("two"); let f(): Int { n + 1 }; f() }
let c2(): Void { let n: Int? = null; run(fn (): Void { take(n) }) }
let t1(): Void { take(top) }
let t2(): Int { topFound + 1 }
let t3(): Void { take(topVar) }
let f1(): Void { let b = new Box(null); take(b.n) }
let a1(): Int { let n = find("two"); let m = n as Int; m }
let a2(): Int { let n: Int? = null; n as Int }
let k1(): Void { let n = find("two"); if (n != null) { take(n) } }
let k2(): Int { let n = find("two"); (n ?? 0) + 1 }
let k3(): Void { let n = find("two"); if (n == null) { return; }; take(n) }
let k4(): Void { let n = find("two"); if (n == null) { panic() }; take(n) }
let k5(): Void { let n = find("two"); let f(): Void { if (n != null) { take(n) } }; f() }
let k6(): Void { let n: Int? = 1; take(n) }
let k7(): Int { let n: Int? = 1 + 1; take(n); n }
let k8(): Void { let n: Int? = if (top == null) { 1 } else { 2 }; take(n) }
let k10(): Int { let n: Int? = 1; n as Int }
let k9(): Void { for (var i = 0; i < 2; ++i) { let n = find("two"); if (n == null) { continue; }; take(n) } }
let n1(): Void { let h: (fn (Int): Boolean)? = null; let g: fn (Int): Boolean = h; }
let dflt(n: Int = 0): Int { n }
let o1(): Int { dflt(find("two")) }
let o2(): Int { let n: Int? = null; dflt(n) }
let o3(): Int { let n = find("one"); dflt(n) }
