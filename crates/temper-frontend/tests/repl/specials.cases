=== the module has what an input uses: vars it assigns, imports, and object literals' classes
var count = 0
let { Date } = import("std/temporal")
class Point(public x: Int, public y: Int) {}
let unused = 1
count = count + 1;
describe(4, "module")
let d = Date.today();
describe(6, "module")
let p: Point = { x: 1, y: 2 }
describe(8, "module")
[{ x: 3, y: 4 }].length
describe(10, "module")
