# REPL sessions: the REPL's own functions, without the tools that
# hover's text, tmpl, and the backends need (temper-driver's tests
# cover those).
=== describe shows an input at the compiler's steps
let x = 1
let twice(n: Int): Int { n * 2 }
twice(x) + 1
describe(2, "parsed")
describe(2)
describe(1, "types")
describe(2, "types")
describe(2, "module")
describe(9, "parsed")
describe(0, "nope")
--- transcript
interactive#0: void
interactive#1: void
interactive#2: 3
(Call #desugarOperation + (Call twice x) 1)
interactive#3: void
(Block (Call + (Call twice:11 x:10) 1))
interactive#4: void
twice: fn (Int32): Int32
interactive#5: void
result: Int32
interactive#6: void
// interactive#0
let x = 1;
// interactive#1
let twice(n: Int): Int { n * 2 };
// interactive#2
twice(x) + 1;
interactive#7: void
Failed: describe: there's no input 9; they're 0 to 8
interactive#8: fail
Failed: describe: the step is "parsed", "settled", "types", "module", or "tmpl"
interactive#9: fail

=== the module renames names declared again
let x = 1
let x = x + 1
let x = x * 10
class P(public a: Int) {}
let p = new P(x)
class P(public b: String) {}
new P("${p.a}")
describe(6, "module")
describe(4, "module")
--- transcript
interactive#0: void
interactive#1: void
interactive#2: void
interactive#3: P
interactive#4: void
interactive#5: P
interactive#6: {class: P, b: "20"}
// interactive#0
let x = 1;
// interactive#1
let x__2 = x + 1;
// interactive#2
let x__3 = x__2 * 10;
// interactive#3
class P(public a: Int) {};
// interactive#4
let p = new P(x__3);
// interactive#5
class P__2(public b: String) {};
// interactive#6
new P__2("${p.a}");
