=== input 0's tests run once, with a summary
let twice(n: Int): Int { n * 2 }; test("doubles") { assert(twice(2) == 4) }; test("zero") { assert(twice(0) == 0) }
--- transcript
Tests passed: 2 of 2
interactive#0: void

=== a failing test says why, and the declarations still work
let twice(n: Int): Int { n * 2 }; test("ok") { assert(twice(1) == 2) }; test("off") { assert(twice(2) == 5) }; test("msg") { assert(false) { "says why" } }
twice(21)
--- transcript
Test failed: off - expected twice(2) == (5) not (4)
Test failed: msg - says why
Tests passed: 1 of 3
interactive#0: void
interactive#1: 42

=== a test that panics fails alone, saying why, and the others still run
let at(ls: List<Int>, i: Int): Int { ls[i] }; test("before") { assert(at([1], 0) == 1) }; test("index") { assert(at([1, 2], 5) == 0) }; test("panic") { panic() }; test("after") { assert(true) }
--- transcript
Test failed: index - Panicked: index 5 out of bounds for length 2
Test failed: panic - Panicked: panic()
Tests passed: 2 of 4
interactive#0: void

=== a failing assert(a == b) shows the values it can, else says the plain message
class P(public n: Int) { @operator("==") public eq(other: P): Boolean { n == other.n } }; let none: List<Int>? = [1]; test("p") { assert(new P(1) == new P(2)) }; test("list") { assert(none == null) }; test("ints") { assert(1 + 1 == 3) }
--- transcript
Test failed: p - expected new P(1) == new P(2)
Test failed: list - expected none == null
Test failed: ints - expected 1 + 1 == (3) not (2)
Tests passed: 0 of 3
interactive#0: void

=== input 0's tests and declarations, used afterwards; later tests refuse
class Point(public x: Int, public y: Int) {}; let origin = new Point(0, 0); test("origin") { console.log("in a test"); assert(origin.x == 0) }
new Point(origin.x + 1, 2)
test("t") { assert(true) }
origin.y
