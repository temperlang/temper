=== runTests runs input 0's tests again, against the newest declarations
let twice(n: Int): Int { n * 2 }; test("three") { assert(twice(3) == 6) }; test("zero") { assert(twice(0) == 0) }
let twice(n: Int): Int { n + 3 }
runTests()
let twice(n: Int): Int { n * 2 }
runTests(); console.log("before the tests")
let twice(s: String): String { s }
runTests()
