# Module namespaces, `let rx = import("std/regex")`, with std loaded:
# input, then diagnostics and what running it logs.

=== a std module as a namespace: types, values, functions, constructors
let rx = import("std/regex");
let t = import("std/temporal");
let r: rx.Regex = new rx.Regex(rx.oneOrMore(new rx.CodePoints("ab")));
let m: rx.Match = r.find("xababy") orelse panic();
console.log(m.full.value);
let groups: Map<String, rx.Group> = m.groups;
let d: t.Date = new t.Date(2024, 2, 29) orelse panic();
console.log(d.toString());
let f(rx: String): String { "${rx}!" }
console.log(f("shadowed"));
let special(): rx.Special { rx.Dot }
console.log(r.found("abab").toString());
--- settled
log abab
log 2024-02-29
log shadowed!
log true

=== a namespace isn't a value
let rx = import("std/regex");
let show(x: AnyValue): Void {}
show(rx);
let same = rx == rx;
console.log("${rx}");
let back(): AnyValue { rx }
let x: rx = 1;
--- settled
error 66..68: rx names a module, not a value; use rx.name for one of its exports
error 82..84: rx names a module, not a value; use rx.name for one of its exports
error 88..90: rx names a module, not a value; use rx.name for one of its exports
error 107..109: rx names a module, not a value; use rx.name for one of its exports
error 137..139: rx names a module, not a value; use rx.name for one of its exports
error 149..151: rx names a module, not a value; use rx.name for one of its exports
Failed: rx names a module, not a value; use rx.name for one of its exports

=== a namespace's members are its exports, and not vars
let rx = import("std/regex");
let a = rx.Regx;
let b = rx.regexRefs;
let c = rx.nothingLikeIt;
rx.Dot = rx.Begin;
--- settled
error 41..45: std/regex does not export symbol Regx; did you mean Regex?
error 58..67: std/regex does not export symbol regexRefs
error 80..93: std/regex does not export symbol nothingLikeIt
error 98..101: Cannot assign to Dot, which is not a var
Failed: std/regex does not export symbol Regx; did you mean Regex?

=== a namespace is a plain top-level let, not exported yet
export let rx = import("std/regex");
var t = import("std/temporal");
let j: Int = import("std/json");
let f(): Void { let n = import("std/json"); }
--- settled
error 0..35: Not supported yet: exporting a module namespace
error 37..67: Use of builtin import is malformed
error 69..100: Use of builtin import is malformed
error 118..144: Use of builtin import is malformed
Failed: Not supported yet: exporting a module namespace

=== core as a namespace and by destructuring
let core = import("core");
let { String as CoreString, console as out } = import("core");
class String(public n: Int) {}
let s: core.String = "text";
let t: CoreString = s;
let mine = new String(2);
out.log(t);
core.console.log(mine.n.toString());
let xs: core.List<core.Int> = [1, 2];
console.log(xs.length.toString());
--- settled
log text
log 2
log 2

=== core's members are its names, but for macros; no builtins.X
let core = import("core");
let a = core.Strin;
let b = core.if;
let { ... } = import("core");
let c = builtins.String;
--- settled
error 64..92: Not supported yet: importing every name of core, which are in scope already
error 40..45: core does not export symbol Strin; did you mean String?
error 60..62: core does not export symbol if; did you mean is?
error 102..110: builtins has not been declared
Failed: core does not export symbol Strin; did you mean String?

=== core and builtins are ordinary names
let builtins = 1;
let core = 2;
let f(core: Int, builtins: Int): Int { core + builtins }
console.log(f(core, builtins).toString());
--- settled
log 3

=== new through a namespace: generics, chained calls, the parenthesized form
let rx = import("std/regex");
let json = import("std/json");
let found = new rx.CodePoints("ab").compiled().found("xaby");
console.log(found.toString());
let adapter: json.JsonAdapter<Int?> = new json.OrNullJsonAdapter<Int>(json.int32JsonAdapter());
let n: json.JsonInt32 = new json.JsonInt32(7);
console.log(n.content.toString());
let older = new (rx.CodePoints)("c").compiled().found("c");
console.log(older.toString());
--- settled
log true
log 7
log true

=== new qualified by anything but a namespace
class Box(public b: Int) {}
class Outer(public box: Box) {}
let outer = new Outer(new Box(1));
let a = new outer.Box(2);
let f(o: Outer): Void { let c = new o.Box(3); }
let d = new Outer.Box(4);
let e = new (outer.box)(5);
--- settled
error 107..116: new takes a class, or a module namespace's, as `new ns.C()`; outer is not a module namespace
error 157..162: new takes a class, or a module namespace's, as `new ns.C()`; o is not a module namespace
error 181..190: new takes a class, or a module namespace's, as `new ns.C()`; Outer is not a module namespace
error 208..217: new takes a class, or a module namespace's, as `new ns.C()`; outer is not a module namespace
Failed: new takes a class, or a module namespace's, as `new ns.C()`; outer is not a module namespace
