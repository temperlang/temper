# std's `testing` with std loaded: input, then diagnostics and what
# running it logs.
=== a method whose result is Never<T> ends its path, as panic() does
// `Test.fail` never returns, so a null check that leaves through it
// narrows what follows, as one that leaves through a method of the
// program's own class does: each called on a parameter or local
// declared with its class's type, which flow facts see before typing.
let { Test } = import("std/testing");
class Stopper {
  public stop(why: String): Never<Void> { panic() }
}
let viaTest(test: Test, n: Int?): Int {
  if (n == null) { test.fail("no n") }
  n + 1
}
let viaOwn(stopper: Stopper, n: Int?): Int {
  if (n == null) { stopper.stop("no n") }
  n + 2
}
let viaLocal(n: Int?): Int {
  let stopper: Stopper = new Stopper();
  if (n == null) { stopper.stop("no n") }
  n + 3
}
let test = new Test();
console.log("${viaTest(test, 1)} ${viaOwn(new Stopper(), 1)} ${viaLocal(1)}");
console.log("${test.passing} ${test.messages().length}");
--- settled
log 2 3 4
log true 0

=== Test.fail records its message and ends the test, past any orelse
// Outside a test runner, its failure ends the run, saying the test's
// messages, the soft ones before it too.
let { Test } = import("std/testing");
let tries(f: fn (): Void throws Bubble): Void { f() orelse console.log("swallowed"); }
let test = new Test();
test.assert(false) { "soft" };
tries { test.fail("hard") };
console.log("went on");
--- settled
soft, hard

=== a local's null check that leaves through Test.fail narrows it
let { Test } = import("std/testing");
let find(s: String): Int? { if (s == "one") { 1 } else { null } }
let viaLocal(test: Test): Int {
  let n = find("one");
  if (n == null) { test.fail("no n") }
  n + 1
}
console.log("${viaLocal(new Test())}");
--- settled
log 2

=== assertPanics doesn't catch the interpreter's own limits
// Calls nested too deeply end the run, where a panic of the program's
// own in the block would pass the check and go on.
let { Test } = import("std/testing");
let deep(n: Int): Int { deep(n + 1) + 1 }
let test = new Test();
test.assertPanics { deep(0); };
console.log("went on ${test.passing}");
--- settled
Panicked: calls nested too deeply

=== assertPanics fails, saying so, when its block throws an error
let { Test } = import("std/testing");
let parse(s: String): Int throws ParseError { s.toInt32() }
let test = new Test();
test.assertPanics { parse("x"); };
test.assertPanics { parse("1"); };
test.assertPanics { [1][2]; };
console.log(test.messages().join(" / ") { it => it });
--- settled
log expected a panic, but it threw / expected a panic

=== a function may throw Error only in std and tests
let f(): Void throws Error {}
--- settled
error 21..26: Error is the root of failure types; throws takes a class or sealed interface that extends it
