# Declared errors (RFC 164) in canonical text: error types under the
# library's roots, results that fail with them, throw, and catch, and what
# the validator's T5, F3, F4, F8, and D6 rules say of them. The format is
# described in tests/text.rs.

=== throw, catch, causes, and a sealed error type
tmpl 1 model 1 library errors 0.1.0

uses `temper-core`#40 0.1.0 {
  interface Error#41 {
    connected get message#42(): String;
    connected get cause#43(): Error#41?;
  }
}

module errors#0 {
  export interface DeclaredErrorsError#1 extends Error#41 {}

  export class NotFound#2 extends DeclaredErrorsError#1 {
    let key#10: String;
    constructor constructor#11(key#12: String): NotFound#2 {
      this.key#10 = key#12;
    }
    get message#13(): String {
      return %String.cat("not found (key: ", %String.cat(this.key#10, ")"));
    }
  }

  export interface SignError#3 extends DeclaredErrorsError#1 {}

  export class BadSign#4 extends SignError#3 {
    constructor constructor#14(): BadSign#4 {}
    get message#15(): String {
      return "bad sign";
    }
  }

  export class EmptyText#5 extends SignError#3 {
    constructor constructor#16(): EmptyText#5 {}
    get message#17(): String {
      return "empty text";
    }
  }

  fn lookup#6(key#18: String): Int32 throws NotFound#2 {
    if (%String.eq(key#18, "a")) {
      return 1;
    }
    (throw(new constructor#11(key#18))^): Void;
  }

  fn sign#7(text#19: String): Int32 throws BadSign#4 {
    if (%String.eq(text#19, "+")) {
      return 1;
    }
    return (throw(new constructor#14())^): Int32;
  }

  fn parseSign#8(text#20: String): Int32 throws SignError#3 {
    if (%String.eq(text#20, "")) {
      (throw((upcast(new constructor#16())): SignError#3)^): Void;
    }
    return sign#7(text#20)^;
  }

  fn setting#9(name#21: String): Int32 throws SignError#3 {
    let n#22: Int32 = (catch(lookup#6(name#21)^, e#23: NotFound#2, (value { let k#27: String = e#23.key#10; 0 }): Int32)): Int32;
    return (catch(lookup#6(name#21)^, ~error#24: NotFound#2, (throw(new constructor#16(), ~error#24)^): Int32)): Int32;
  }

  init {
    let m#25: String = (catch((value { parseSign#8("?")^; "fine" }): String, e#26: SignError#3, ((upcast(e#26)): Error#41).message#42())): String;
  }
}

=== error problems (T5, F3, F4, F8, D6)
tmpl 1 model 1 library errors 0.1.0

uses `temper-core`#40 0.1.0 {
  interface Error#41 {
    connected get message#42(): String;
    connected get cause#43(): Error#41?;
  }
}

module errors#0 {
  export interface DeclaredErrorsError#1 extends Error#41 {}

  export interface OtherError#2 extends Error#41 {}

  export class NotFound#3 extends DeclaredErrorsError#1 {
    constructor constructor#10(): NotFound#3 {}
  }

  export class Direct#4 extends Error#41 {
    constructor constructor#11(): Direct#4 {}
  }

  export interface Box#5<T#12> extends DeclaredErrorsError#1 {}

  export interface Other#6 extends DeclaredErrorsError#1 {}

  export class Both#7 extends Other#6, DeclaredErrorsError#1 {
    constructor constructor#13(): Both#7 {}
  }

  fn lookup#8(): Int32 throws NotFound#3 {
    (throw(new constructor#10())): Void;
    return 1;
  }

  fn wrong#9(n#14: Int32): Int32 throws String {
    (throw("no")^): Void;
    let a#15: Int32 = (catch(lookup#8()^, e#16: String, 0)): Int32;
    let b#17: Int32 = (catch((throw(new constructor#13())^): Int32, e#18: NotFound#3, 0)): Int32;
    return 0;
  }

  fn quiet#19(): Int32 {
    return lookup#8()^;
  }

  fn other#20(): Int32 throws OtherError#2 {
    let c#21: Int32 = lookup#8()^;
    return (throw(new constructor#10(), 1)^): Int32;
  }

  init {}
}
--- problems
D6 #4: an error class extends a root, not Error itself
D6 #5: an error type can't be generic
D6 #7: an error type has more than one error type above it
F3 @16: throw fails, but isn't marked
T5 #9: fn (Int32): Int32 throws String fails with String, not an error type
F8 @25: throw's value is String, not an error type
F8 @27: a catch binds String, not an error type
F4 @28: the call of lookup#8 may fail with NotFound#3, but its catch takes only String
F4 @32: throw fails with Both#7, but its catch takes only NotFound#3
F4 @40: the call of lookup#8 may fail with NotFound#3, but quiet#19 can't
F4 @44: the call of lookup#8 may fail with NotFound#3, but other#20 takes only OtherError#2
F4 @46: throw fails with NotFound#3, but other#20 takes only OtherError#2
F8 @48: throw's cause is Int32, not an error type

=== error parameters (RFC 164)
tmpl 1 model 1 library errors 0.1.0

uses `temper-core`#40 0.1.0 {
  interface Error#41 {
    connected get message#42(): String;
    connected get cause#43(): Error#41?;
  }
}

module errors#0 {
  export interface DeclaredErrorsError#1 extends Error#41 {}

  export class NotFound#2 extends DeclaredErrorsError#1 {
    constructor constructor#10(): NotFound#2 {}
  }

  export fun interface Thunk#3<E#11 extends Error#41> {
    abstract method apply#12(): Int32 throws E#11;
  }

  export fn apply#4<E#13 extends Error#41>(f#14: Thunk#3<E#13>): Int32 throws E#13 {
    return f#14()^;
  }

  export fn again#5<E#15 extends Error#41>(f#16: fn (): Int32 throws E#15): Int32 throws E#15 {
    return (catch(f#16()^, e#17: E#15, (throw(e#17, e#17)^): Int32)): Int32;
  }

  export fn count#6<E#18 extends Error#41>(f#19: fn (): Int32 throws E#18): Int32 {
    return (orelse(f#19()^, 0)): Int32;
  }

  fn lookup#7(): Int32 throws NotFound#2 {
    return (throw(new constructor#10())^): Int32;
  }

  init {
    let a#20: Int32 = (orelse(apply#4<NotFound#2>((fn ~fn#21(): Int32 throws NotFound#2 {
      return lookup#7()^;
    }): Thunk#3<NotFound#2>)^, 0)): Int32;
    let b#22: Int32 = apply#4<Never<Error#41>>((fn ~fn#23(): Int32 {
      return 1;
    }): Thunk#3<Never<Error#41>>);
    let c#24: Int32 = count#6<NotFound#2>((fn ~fn#25(): Int32 throws NotFound#2 {
      return lookup#7()^;
    }): fn (): Int32 throws NotFound#2);
  }
}

=== error parameter problems (T4, T5, F4, F8)
tmpl 1 model 1 library errors 0.1.0

uses `temper-core`#40 0.1.0 {
  interface Error#41 {
    connected get message#42(): String;
    connected get cause#43(): Error#41?;
  }
}

module errors#0 {
  export interface DeclaredErrorsError#1 extends Error#41 {}

  export class NotFound#2 extends DeclaredErrorsError#1 {
    constructor constructor#10(): NotFound#2 {}
  }

  fn loose#3<T#11>(f#12: fn (): Int32 throws T#11): Int32 throws T#11 {
    return f#12()^;
  }

  fn quiet#4<E#13 extends Error#41>(f#14: fn (): Int32 throws E#13): Int32 {
    return f#14()^;
  }

  fn narrow#5<E#15 extends Error#41>(f#16: fn (): Int32 throws E#15): Int32 throws E#15 {
    return (throw(new constructor#10())^): Int32;
  }

  fn apply#6<E#17 extends Error#41>(f#18: fn (): Int32 throws E#17): Int32 throws E#17 {
    return f#18()^;
  }

  init {
    let b#21: Int32 = apply#6<String>((fn ~fn#22(): Int32 {
      return 1;
    }): fn (): Int32 throws String)^;
  }
}
--- problems
T5 #3: fn (fn (): Int32 throws T#11): Int32 throws T#11 fails with T#11, not an error type
T5 #12: fn (): Int32 throws T#11 fails with T#11, not an error type
F4 @14: the call of the function value may fail with E#13, but quiet#4 can't
F4 @20: throw fails with NotFound#2, but narrow#5 takes only E#15
T4 @30: type argument String isn't within E#17's bound Error#41
V1 @31: FunctionLiteral is fn (): Int32 throws String, but its signature is fn (): Int32

=== generator errors (F4, F6)
tmpl 1 model 1 library errors 0.1.0

uses `temper-core`#40 0.1.0 {
  interface Error#41 {
    connected get message#42(): String;
    connected get cause#43(): Error#41?;
  }
  interface GeneratorResult#44<YIELD#45> {}
  interface Generator#46<YIELD#47> {
    connected method next#48(): GeneratorResult#44<YIELD#47> throws Error#41;
  }
  interface SafeGenerator#49<YIELD#50> extends Generator#46<YIELD#50> {
    connected method nextSafe#51(): GeneratorResult#44<YIELD#50>;
  }
}

module errors#0 {
  export interface DeclaredErrorsError#1 extends Error#41 {}

  export class TooBig#2 extends DeclaredErrorsError#1 {
    constructor constructor#10(): TooBig#2 {}
  }

  fn failing#3(): fn (): Generator#46<Int32> {
    return (fn generator ~fn#11(): Generator#46<Int32> {
      yield 1;
      (throw(new constructor#10())^): Void;
    }): fn (): Generator#46<Int32>;
  }

  fn safe#4(): fn (): SafeGenerator#49<Int32> {
    return (fn generator ~fn#12(): SafeGenerator#49<Int32> {
      yield 1;
      (throw(new constructor#10())^): Void;
    }): fn (): SafeGenerator#49<Int32>;
  }

  fn first#5(g#13: Generator#46<Int32>): GeneratorResult#44<Int32> throws TooBig#2 {
    return g#13.next#48()^;
  }

  fn quiet#6(g#14: Generator#46<Int32>): Int32 {
    let r#15: GeneratorResult#44<Int32> = (catch(g#14.next#48()^, e#16: Error#41, (throw(new constructor#10())^): GeneratorResult#44<Int32>)): GeneratorResult#44<Int32>;
    return 0;
  }

  init {}
}
--- problems
F4 @22: throw fails with TooBig#2, but ~fn#12 can't
F4 @28: the call of next#48 may fail with Error#41, but first#5 takes only TooBig#2
F4 @37: throw fails with TooBig#2, but quiet#6 can't
