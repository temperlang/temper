/compat/oracle/classes
/target
__pycache__/

# A local decision-graph tool's database
.deciduous/

# The `stats` branch, checked out here for compat/'s size and speed scripts
/stats/

# javac's argument files, left behind when a compile fails
javac.*.args

# The site's build output (docs, playground, and Kelpto's build) and npm packages
/site/_out/
/site/playground/node_modules
/site/docs/mermaid/node_modules

# CI's pinned checkers (.github/ci-tools/), when installed locally
/.github/ci-tools/node_modules

# The VS Code extension's build output, npm packages, and the VS Code its
# tests download
/editors/vscode/out/
/editors/vscode/node_modules
/editors/vscode/.vscode-test/

# Checkers' and tests' leftovers in the backends' runtimes
/crates/temper-be-*/runtime/**/.mypy_cache/
/crates/temper-be-*/runtime/**/__pycache__/
/crates/temper-be-*/runtime/**/node_modules/
/crates/temper-be-*/runtime/**/target/

# Crash dumps and profiles that test runs can leave behind: the JVM's
# crash and compiler-replay logs, numbered core dumps (a bare `core` is
# left out, as directories here have that name), Valgrind's, MSYS bash's
# on Windows, and LLVM's coverage profiles
hs_err_pid*.log
replay_pid*.log
core.[0-9]*
vgcore.*
*.stackdump
*.profraw
