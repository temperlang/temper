class HasTooManyConstructors {
  // The initializer here would need to be copied into multiple constructors,
  // but we do not want to copy code that is potentially large, so just ban it.
  private var b: Boolean = false;

  public constructor() {}
  public constructor(c: Boolean) {
    if (c) { this.b = !this.b; }
