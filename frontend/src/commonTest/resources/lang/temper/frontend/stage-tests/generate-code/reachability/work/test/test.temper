export let exported(): Void {
  usedByExported();
}

@keep
let kept(): Void {
  usedByKept();
}

@keep
class KeptClass {
  public keptClassMethod(): Void {}
}

@keepTest
let testKept(): Void {
  usedByTestKept();
}

// The following are all kept only depending on the above.
// Log from all of these so they don't get inlined or ignored.

let usedByExported(): Void {
  console.log("usedByExported");
}

let usedByKept(): Void {
  console.log("usedByKept");
}

let usedByTestKept(): Void {
  console.log("usedByTestKept");
}

let usedByNothing(): Void {
  console.log("usedByNothing");
}
