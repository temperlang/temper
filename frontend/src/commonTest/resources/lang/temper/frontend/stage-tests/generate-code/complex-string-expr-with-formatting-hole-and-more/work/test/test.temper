"""
:var after = "and such";
:for (var i = 1; i < 100; i *= 2) {
  // Comment inside loop before split content.
  // Second comment.
  :let j = i - 1;
  ~${j + 1}
  :after = "and so on";
  ~,
  :do {
    // And a trailing space inside a nested block.
    ~ ${}
  :}
  // Just some nothings for funsies.
  ~
  ~
:}
~${after}
