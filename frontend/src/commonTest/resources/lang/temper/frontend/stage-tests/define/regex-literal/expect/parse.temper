REM("Some tests below:", true, true);
REM("Interpolated string value next to another interpolation. Also test a disappearing empty hole.", true, true);
REM("Simple interpolated string value since we can't evaluate regex objects at compile time yet.", true, true);
REM("Starting off with a simple regex", true, true);
let r1 = rgx(list("a.b*"), list());
REM("b is not in scope here.", true, true);
let r2 = rgx(list("a.\u{24}{b}*"), list());
REM("We don't actually support the following flag syntax at the moment.\nThat's one of the syntax error messages.", true, true);
let r3 = rgx(list("(?/g)a.b*"), list()), b = r3;
REM("And we have a brief interpolation representation from Grammar that's\neasyish to build.  It gets changed later.", true, true);
let r4 = stringExpr(rgx, true, "a.", \interpolate, b, "*"), r5 = stringExpr(rgx, true, "a", \interpolate, ".", \interpolate, b, "*?"), r6 = stringExpr(rgx, true, "a", \interpolate, ".", "*"), r7 = new Sequence(list(new CodePoints("a"), Dot, new Repeat(new CodePoints("b"), 0, null))).compiled(), s = "[a]", r8 = stringExpr(rgx, true, ".", \interpolate, s, ".");
