let { QuoteBuilder } = import("./autoesc");

// The accumulator is replaced by its collector, and escapers are
// picked at compile time based on whether we're inside quotes.
export let f(x: String): String {
  QuoteBuilder"a ${x} 'b ${x}' c"
}

// A second use. Together, the uses take more interpreter steps than the
// module's budget, though each fits in the budget the optimizer gives it.
export let g(x: String): String {
  QuoteBuilder"'${x}'"
}
