## The temporaries make this somewhat easier to visualize than
## the syntaxMacro.temper output.
## Inline below are the pre-sugared expressions.
  @fn let `test//`.a;
  `test//`.a = (@stay fn a(x__1 /* aka x */: Int32, y__2 /* aka y */: Int32, z__3 /* aka z */: Int32?, w__4 /* aka w */: Int32?) /* return__0 */: (List<Boolean>) {
      let t#6, t#8, t#9, t#10, t#11, t#12, t#13, t#14, t#15, t#17, t#19, t#20, t#22, t#25, t#26;
## x == y;  Neither is nullable, so it's just int comparison.
      t#8 = x__1 == y__2;
## x != y;  Just the negation of the above.
      t#9 = !(x__1 == y__2);
## x < y
      t#10 = x__1 <=> y__2 < 0;
## x <= y
      t#11 = x__1 <=> y__2 <= 0;
## x >= y
      t#12 = x__1 <=> y__2 >= 0;
## x > y
      t#13 = x__1 <=> y__2 > 0;
## (x <=> y) != 0;  all integer ops except for the `!`
      t#14 = !(x__1 <=> y__2 == 0);
## x == null and null != y are inlined as false and true at the bottom.
## x == z; first dealing with case where z is null
      if (isNull(z__3)) {
        t#6 = false
      } else {
## using `notNull` around z allows for matching the (int*int)->bool sig to match.
        t#6 = x__1 == notNull(z__3)
      };
## x != z; just the negation of the block above.
      if (isNull(z__3)) {
        t#15 = false
      } else {
        t#15 = x__1 == notNull(z__3)
      };
      t#19 = !t#15;
## z == x; functionally same as two above, but different operand order.
      if (isNull(z__3)) {
        t#17 = false
      } else {
        t#17 = notNull(z__3) == x__1
      };
## z != x
      if (isNull(z__3)) {
        t#20 = false
      } else {
        t#20 = notNull(z__3) == x__1
      };
      t#25 = !t#20;
## z == w; both have nullable types.
      if (isNull(z__3)) {
        t#22 = isNull(w__4)
      } else {
        let t#23;
        if (isNull(w__4)) {
          t#23 = false
        } else {
          t#23 = notNull(z__3) == notNull(w__4)
        };
        t#22 = t#23
      };
## z != w
      if (isNull(z__3)) {
        t#26 = isNull(w__4)
      } else {
        let t#27;
        if (isNull(w__4)) {
          t#27 = false
        } else {
          t#27 = notNull(z__3) == notNull(w__4)
        };
        t#26 = t#27
      };
## w == null; See the last expression that was not pulled out into a temporary
      return__0 = list(t#8, t#9, t#10, t#11, t#12, t#13, t#14, false, true, t#6, t#19, t#17, t#25, t#22, !t#26, isNull(w__4))
  })
